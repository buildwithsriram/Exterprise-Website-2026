// Cloudflare hosting (Workers static assets), deployed automatically from GitHub by Workers Builds.
// The build copies only the public site into dist/ (tools/build.sh).
// html_handling "auto-trailing-slash" matches Cloudflare Pages: /about serves about.html and /about.html redirects to /about.
{
  "name": "exterprise-website-2026",
  "compatibility_date": "2025-09-01",
  "build": { "command": "sh tools/build.sh" },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
