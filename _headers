# Cloudflare response headers. GitHub Pages ignores this file.

# Security headers on every response.
# Content-Security-Policy lists the only sources the site loads from: its own files, the YouTube
# embed and Cloudflare Turnstile (the contact forms' bot check). The two sha256 values allow the inline scripts in 404.html;
# if those scripts change, recompute them (the browser console prints the new value).
# It runs as Report-Only first: violations appear in the browser console but nothing is blocked.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com 'sha256-sA2F/XyeVvC1cCNXfcBrGpru8YEyXHKxUSfUGJqQ58o=' 'sha256-psah3RQK8vFoulBJu5bt6QHZjbzbNHk/OFDYb9hzzsA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# To enforce the policy once the console shows no violations, replace the Report-Only line above with:
#  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com 'sha256-sA2F/XyeVvC1cCNXfcBrGpru8YEyXHKxUSfUGJqQ58o=' 'sha256-psah3RQK8vFoulBJu5bt6QHZjbzbNHk/OFDYb9hzzsA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
# If Cloudflare Web Analytics is turned on, add https://static.cloudflareinsights.com to script-src
# and https://cloudflareinsights.com to connect-src.

# Keep the pages.dev preview addresses out of search results (only www.exterprise.us should be indexed).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Pages: always check for the latest deploy, so changes show up immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# style.css and site.js are loaded with ?v=<content hash>, so a new version always has a new address
/style.css
  Cache-Control: public, max-age=31536000, immutable
/site.js
  Cache-Control: public, max-age=31536000, immutable

# Fonts and libraries never change
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Images and videos: one week, refreshed in the background (they keep their names when replaced)
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Files for search engines and AI agents
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/agents.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
